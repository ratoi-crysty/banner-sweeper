{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AutoConsentCMPRule",
  "definitions": {
    "AutoConsentCMPRule": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "vendorUrl": {
          "type": "string",
          "deprecated": "Use `_metadata.vendorUrl` instead."
        },
        "prehideSelectors": { "type": "array", "items": { "type": "string" } },
        "runContext": { "$ref": "#/definitions/RunContext" },
        "intermediate": { "type": "boolean" },
        "cosmetic": { "type": "boolean" },
        "detectCmp": {
          "type": "array",
          "items": { "$ref": "#/definitions/AutoConsentRuleStep" }
        },
        "detectPopup": {
          "type": "array",
          "items": { "$ref": "#/definitions/AutoConsentRuleStep" }
        },
        "optOut": {
          "type": "array",
          "items": { "$ref": "#/definitions/AutoConsentRuleStep" }
        },
        "optIn": {
          "type": "array",
          "items": { "$ref": "#/definitions/AutoConsentRuleStep" }
        },
        "openCmp": {
          "type": "array",
          "items": { "$ref": "#/definitions/AutoConsentRuleStep" }
        },
        "test": {
          "type": "array",
          "items": { "$ref": "#/definitions/AutoConsentRuleStep" }
        },
        "comment": { "type": "string" },
        "minimumRuleStepVersion": { "type": "number" },
        "_metadata": {
          "type": "object",
          "properties": {
            "manuallyReviewUpdates": { "type": "boolean" },
            "vendorUrl": { "type": "string" },
            "deduplicatedFrom": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["name", "detectCmp", "detectPopup", "optOut", "optIn"],
      "additionalProperties": false
    },
    "RunContext": {
      "type": "object",
      "properties": {
        "main": { "type": "boolean" },
        "frame": { "type": "boolean" },
        "urlPattern": { "type": "string" }
      },
      "additionalProperties": false
    },
    "AutoConsentRuleStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stylesheet": { "type": "string" },
        "stylesheetId": { "type": "string" },
        "addStyle": { "type": "string" },
        "selector": { "$ref": "#/definitions/ElementSelector" },
        "setStyle": { "type": "string" },
        "removeClass": { "type": "string" },
        "cookieContains": { "type": "string" },
        "negated": { "type": "boolean" },
        "any": {
          "type": "array",
          "items": { "$ref": "#/definitions/AutoConsentRuleStep" }
        },
        "if": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visible": { "$ref": "#/definitions/ElementSelector" },
            "check": { "$ref": "#/definitions/VisibilityCheck" },
            "exists": { "$ref": "#/definitions/ElementSelector" }
          }
        },
        "then": {
          "type": "array",
          "items": { "$ref": "#/definitions/AutoConsentRuleStep" }
        },
        "else": {
          "type": "array",
          "items": { "$ref": "#/definitions/AutoConsentRuleStep" }
        },
        "hide": { "type": "string" },
        "method": { "$ref": "#/definitions/HideMethod" },
        "wait": { "type": "number" },
        "waitForThenClick": { "$ref": "#/definitions/ElementSelector" },
        "timeout": { "type": "number" },
        "all": { "type": "boolean" },
        "retry": {
          "type": "number",
          "description": "Number of additional click attempts if the element is still visible after the first click. Defaults to 0 (no retries). Only use this on elements that are expected to disappear once the click is handled, otherwise the extra clicks are wasted (or harmful)."
        },
        "retryInterval": {
          "type": "number",
          "description": "How long to wait (in ms) for the element to disappear before clicking it again."
        },
        "click": { "$ref": "#/definitions/ElementSelector" },
        "waitForVisible": { "$ref": "#/definitions/ElementSelector" },
        "check": { "$ref": "#/definitions/VisibilityCheck" },
        "waitFor": { "$ref": "#/definitions/ElementSelector" },
        "eval": {
          "type": "string",
          "enum": [
            "EVAL_0",
            "EVAL_DIDOMI_OPT_OUT",
            "EVAL_DIDOMI_TEST",
            "EVAL_CONSENTMANAGER_1",
            "EVAL_CONSENTMANAGER_2",
            "EVAL_CONSENTMANAGER_3",
            "EVAL_CONSENTMANAGER_4",
            "EVAL_CONSENTMANAGER_5",
            "EVAL_CONSENTMANAGER_NCMP_REJECT",
            "EVAL_CONSENTMANAGER_NCMP_ACCEPT",
            "EVAL_COOKIEBOT_1",
            "EVAL_COOKIEBOT_2",
            "EVAL_COOKIEBOT_3",
            "EVAL_COOKIEBOT_4",
            "EVAL_COOKIEBOT_5",
            "EVAL_KLARO_1",
            "EVAL_KLARO_OPEN_POPUP",
            "EVAL_KLARO_TRY_API_OPT_OUT",
            "EVAL_ONETRUST_1",
            "EVAL_TRUSTARC_TOP",
            "EVAL_TRUSTARC_FRAME_TEST",
            "EVAL_TRUSTARC_FRAME_GTM",
            "EVAL_ADOPT_TEST",
            "EVAL_ADULTFRIENDFINDER_TEST",
            "EVAL_AYLO_COOKIE_MANAGER_READY",
            "EVAL_BAHN_TEST",
            "EVAL_BIGCOMMERCE_CONSENT_MANAGER_DETECT",
            "EVAL_BORLABS_0",
            "EVAL_CC_BANNER2_0",
            "EVAL_COINBASE_0",
            "EVAL_COOKIE_POPUP_CLOSE",
            "EVAL_COOKIE_LAW_INFO_0",
            "EVAL_COOKIE_LAW_INFO_DETECT",
            "EVAL_COOKIE_MANAGER_POPUP_0",
            "EVAL_COOKIEALERT_0",
            "EVAL_COOKIEALERT_1",
            "EVAL_COOKIEALERT_2",
            "EVAL_COOKIEFIRST_0",
            "EVAL_COOKIEFIRST_1",
            "EVAL_COOKIEINFORMATION_0",
            "EVAL_COOKIEINFORMATION_1",
            "EVAL_COOKIEREPORTS_OPT_OUT",
            "EVAL_COOKIEREPORTS_OPT_IN",
            "EVAL_COOKIEREPORTS_TEST",
            "EVAL_EE_CONSENT_DECLINE_0",
            "EVAL_ETSY_0",
            "EVAL_ETSY_1",
            "EVAL_EZOIC_0",
            "EVAL_FIDES_DETECT_POPUP",
            "EVAL_GDPR_LEGAL_COOKIE_DETECT_CMP",
            "EVAL_GDPR_LEGAL_COOKIE_TEST",
            "EVAL_IUBENDA_0",
            "EVAL_IUBENDA_1",
            "EVAL_KROWN_COOKIE_BANNER_TEST",
            "EVAL_MICROSOFT_0",
            "EVAL_MICROSOFT_1",
            "EVAL_MICROSOFT_2",
            "EVAL_MOOVE_0",
            "EVAL_NHNIEUWS_TEST",
            "EVAL_OSANO_DETECT",
            "EVAL_PANDECTES_TEST",
            "EVAL_POVR_GOBACK",
            "EVAL_PUBTECH_0",
            "EVAL_SHOPIFY_TEST",
            "EVAL_SKYSCANNER_TEST",
            "EVAL_SIRDATA_UNBLOCK_SCROLL",
            "EVAL_SOURCEPOINT_RESTORE_SCROLL",
            "EVAL_STEAMPOWERED_0",
            "EVAL_TAKEALOT_0",
            "EVAL_TARTEAUCITRON_0",
            "EVAL_TARTEAUCITRON_1",
            "EVAL_TARTEAUCITRON_2",
            "EVAL_TEALIUM_0",
            "EVAL_TEALIUM_1",
            "EVAL_TEALIUM_DONOTSELL",
            "EVAL_TEALIUM_2",
            "EVAL_TEALIUM_3",
            "EVAL_TEALIUM_DONOTSELL_CHECK",
            "EVAL_TESTCMP_STEP",
            "EVAL_TESTCMP_0",
            "EVAL_TESTCMP_COSMETIC_0",
            "EVAL_THEFREEDICTIONARY_0",
            "EVAL_THEFREEDICTIONARY_1",
            "EVAL_USERCENTRICS_API_0",
            "EVAL_USERCENTRICS_API_1",
            "EVAL_USERCENTRICS_API_2",
            "EVAL_USERCENTRICS_API_3",
            "EVAL_USERCENTRICS_API_4",
            "EVAL_USERCENTRICS_API_5",
            "EVAL_USERCENTRICS_API_6",
            "EVAL_USERCENTRICS_BUTTON_0",
            "EVAL_WAITROSE_0",
            "EVAL_WBD_LTP_CLOSE"
          ]
        },
        "visible": { "$ref": "#/definitions/ElementSelector" },
        "exists": { "$ref": "#/definitions/ElementSelector" },
        "optional": { "type": "boolean" },
        "comment": { "type": "string" }
      }
    },
    "ElementSelector": {
      "anyOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "VisibilityCheck": { "type": "string", "enum": ["any", "all", "none"] },
    "HideMethod": { "type": "string", "enum": ["display", "opacity"] }
  }
}
